---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import members from '../assets/brand/members.png';
import { site } from '../data/site';
import Button from './Button.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <a href={url('/')} class="footer__badge" aria-label={`${site.name}, home`}>
          <Image src={logo} alt="" width={120} height={79} widths={[120, 180, 240, 360]} sizes="(min-width: 1441px) calc(66px + 3.75vw), 120px" />
        </a>
        <p class="footer__news">Brew news, straight from the farm</p>
        <Button href={site.links.newsletter} label="Join the list" variant="cream" />
      </div>
      <div class="footer__cols">
        <div>
          <h2 class="footer__h">Visit</h2>
          <address>
            {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}<br />
            <a class="u" href={site.phoneHref}>{site.phone}</a><br />
            <a class="u" href={`mailto:${site.email}`}>{site.email}</a>
          </address>
        </div>
        <div>
          <h2 class="footer__h">Hours</h2>
          <ul>{site.hours.map((h) => <li>{h.days}: {h.time}</li>)}<li>Trails & course: open daily</li></ul>
        </div>
        <div>
          <h2 class="footer__h">Out back</h2>
          <ul>
            <li><a class="u" href={url('/#farm-trail')}>Farm Trail</a></li>
            <li><a class="u" href={site.links.bikeRentals}>Bike Rentals</a></li>
            <li><a class="u" href={url('/#celebrate')}>Private Parties</a></li>
            <li><a class="u" href={url('/#catering')}>Catering</a></li>
            <li><a class="u" href={url('/#jobs')}>Jobs</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer__h">Elsewhere</h2>
          <ul>
            <li><a class="u" href={site.links.merch} target="_blank" rel="noopener">Merch</a></li>
            <li><a class="u" href={site.links.storeLocator}>Store Locator</a></li>
            {site.socials.map((s) => <li><a class="u" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
    <p class="footer__finale" aria-hidden="true">See you on the hill</p>
    <div class="footer__bottom">
      <div class="footer__members">
        <span>Proud members</span>
        <Image src={members} alt="Connecticut Brewers Guild and Brewers Association Certified Independent Craft" width={150} height={102} widths={[150, 225, 300, 450]} sizes="(min-width: 1441px) calc(83px + 4.7vw), 150px" />
      </div>
      <p class="footer__legal">© {year} {site.name}. Please drink responsibly, 21+ to purchase.</p>
    </div>
  </div>
</footer>
