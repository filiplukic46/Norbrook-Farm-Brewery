---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { nav, site } from '../data/site';
import Button from './Button.astro';
interface Props { current?: string }
const { current } = Astro.props;
---
<header class="header" data-header>
  <div class="header__inner">
    <a href={url('/')} class="header__logo" aria-label={`${site.name}, home`}>
      <Image src={logo} alt="" width={118} height={77} widths={[118, 180, 240, 360]} sizes="(max-width: 900px) 76px, (min-width: 1441px) calc(65px + 3.7vw), 118px" loading="eager" />
    </a>
    <nav class="header__nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a class="draw" href={n.href} aria-current={current === n.label ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="header__open" data-open>
      <span class="header__dot" aria-hidden="true"></span>
      <span data-open-text>Wed to Sat 12 to 8, Sun 12 to 6</span>
    </p>
    <Button href={site.links.order} label="Order to go" class="header__cta" />
    <button class="header__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>Menu</button>
  </div>
  <div class="menu" id="menu" hidden data-menu>
    <nav aria-label="Mobile">
      <ul>
        {nav.map((n) => (<li><a href={n.href} data-menu-link>{n.label}</a></li>))}
        <li><a href={site.links.order} target="_blank" rel="noopener" data-menu-link>Order to go</a></li>
      </ul>
    </nav>
    <p class="menu__meta">{site.address.street}, {site.address.city}, {site.address.region}<br />{site.phone}</p>
  </div>
</header>
